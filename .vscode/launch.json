{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 IMSystemXST (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/IMSystemXST.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
